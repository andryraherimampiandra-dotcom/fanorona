{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "FANORONA_SERVER_URL": "wss://fanorona-server.fly.dev/ws"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "FANORONA_SERVER_URL": "wss://fanorona-server.fly.dev/ws"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
